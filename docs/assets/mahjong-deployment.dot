digraph deployment {
  graph [rankdir=TB, bgcolor="#F5F8FC", pad="0.45", nodesep="0.6", ranksep="0.6", fontname="Liberation Sans", fontsize=24, labelloc=t, label="MAHJONG CREW\nShared foundation. Separate apps and data."];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#CBD5E1", penwidth=1.4, fontname="Liberation Sans", fontsize=16, fontcolor="#14283F", margin="0.25,0.20"];
  edge [color="#6F8197", arrowsize=0.8, fontname="Liberation Sans", fontsize=12, fontcolor="#4B6078"];

  code [label="ONE PLANNED NEXT.JS CODEBASE\nShared: login • crews • RSVP • confirmations\nSeparate: tennis/badges | tables/scores", fillcolor="#E8EFF9", color="#7D9EC5"];
  ci [label="CI: test both products\nBuild independent, versioned app images", fillcolor="#E8EFF9", color="#7D9EC5"];
  code -> ci;

  players [label="Players & organizers\nMobile browser / home-screen web app"];

  subgraph cluster_vps {
    label="EXISTING HOSTINGER VPS"; fontname="Liberation Sans"; fontsize=18; fontcolor="#37516D"; color="#AFBDD0"; style="rounded"; margin=24;
    proxy [label="Traefik HTTPS proxy — verified running\nExisting app-net network • no new public app port", fillcolor="#F0F4FA"];
    mahjong [label="NEW: MAHJONG CREW CONTAINER\nProposed: mahjong.aauth.tech\nTables • duties • manual scoring", fillcolor="#E2F3EC", color="#39896D", penwidth=2];
    bb [label="FUTURE: BB PLAYER CONTAINER\nPlanned: player.aauth.tech\nTennis • court groups • badges", fillcolor="#F0F3F8", color="#94A3B8", style="rounded,filled,dashed"];
    {rank=same; mahjong; bb;}
    proxy -> mahjong [label="proposed route"];
    proxy -> bb [label="future route", style=dashed];
  }

  players -> proxy [label="HTTPS"];
  ci -> mahjong [label="release separately", style=dashed, color="#39896D"];
  ci -> bb [label="release separately", style=dashed];

  mjdata [label="MAHJONG DATA / IDENTITY\nOwn Supabase production project\nScoped AuthKit configuration", fillcolor="#E2F3EC", color="#39896D"];
  bbdata [label="BB DATA / IDENTITY\nSeparate Supabase production project\nSeparate auth configuration", fillcolor="#F0F3F8", color="#94A3B8", style="rounded,filled,dashed"];
  {rank=same; mjdata; bbdata;}
  mahjong -> mjdata [label="authenticated + RLS"];
  bb -> bbdata [label="authenticated + RLS", style=dashed];

  note [shape=plaintext, label="PROPOSAL ONLY — PRODUCT APPS ARE NOT DEPLOYED\nStaging uses separate credentials/data. No shared player records.\nExisting unrelated containers stay untouched.", fontsize=13, fontcolor="#52657D", fillcolor="#F5F8FC", color="#F5F8FC"];
  mjdata -> note [style=invis]; bbdata -> note [style=invis];
}
